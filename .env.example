# Server Configuration
PORT=5000

# MySQL Database Configuration (Aiven / Localhost / Remote)
DB_HOST=your-db-host.aivencloud.com
DB_PORT=20784
DB_USER=avnadmin
DB_PASSWORD=your_db_password
DB_NAME=defaultdb

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_2026

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email Service (SMTP for Password Reset OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-or-smtp-key
EMAIL_FROM="EventX Support" <no-reply@eventx.com>
